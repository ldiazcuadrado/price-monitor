# Copy to .env and fill in only what you use. All variables are optional.

PRICE_MONITOR_CONFIG_PATH=sites.yaml
PRICE_MONITOR_DB_PATH=data/price_monitor.db
PRICE_MONITOR_LOG_LEVEL=INFO
# text or json
PRICE_MONITOR_LOG_FORMAT=text
# Sent with every request unless a site overrides it. Include a contact address.
PRICE_MONITOR_USER_AGENT=price-monitor/0.1 (+mailto:you@example.com)

# watch command
PRICE_MONITOR_WATCH_INTERVAL=6h
PRICE_MONITOR_WATCH_JITTER=0.1

# Telegram (create a bot with @BotFather, then message it once to get the chat id)
PRICE_MONITOR_TELEGRAM_BOT_TOKEN=
PRICE_MONITOR_TELEGRAM_CHAT_ID=

# SMTP email
PRICE_MONITOR_SMTP_HOST=
PRICE_MONITOR_SMTP_PORT=587
PRICE_MONITOR_SMTP_USERNAME=
PRICE_MONITOR_SMTP_PASSWORD=
PRICE_MONITOR_SMTP_FROM=
# Comma-separated
PRICE_MONITOR_SMTP_TO=
# starttls, ssl or none
PRICE_MONITOR_SMTP_SECURITY=starttls

# Generic JSON webhook
PRICE_MONITOR_WEBHOOK_URL=
PRICE_MONITOR_WEBHOOK_BEARER_TOKEN=
